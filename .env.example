# Agentic Trader — Environment Configuration
# Copy to .env and fill in your values.
# Lines starting with # are comments. All values are optional unless marked REQUIRED.

# ─────────────────────────────────────────────────────────────────────────────
# WEB SERVER
# ─────────────────────────────────────────────────────────────────────────────
WEB_PORT=8001
WEB_HOST=127.0.0.1

# Public URL (used in SMS/email alerts). Leave blank for local-only use.
PUBLIC_APP_URL=
PUBLIC_DASHBOARD_URL=

# Comma-separated origins allowed for CORS (add your frontend dev URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# PAPER TRADING
# ─────────────────────────────────────────────────────────────────────────────

# Directory where portfolio state files are written
# Default: tmp/paper_trading_today — portfolio comparison dashboard reads from here
PAPER_OUTPUT_DIR=tmp/paper_trading_today

# Auto-start paper trading on web server launch
# (set to true only if you want hands-off daily automation)
PAPER_AUTOSTART_IGNORE_WINDOW=false

# Thematic auto-scan (experimental sector momentum overlay)
THEMATIC_AUTO_SCAN=false

# ─────────────────────────────────────────────────────────────────────────────
# PORTFOLIO / RISK PARAMETERS
# These override the default CLI args for paper_trade_today.py.
# All are optional — unset = use the script's built-in defaults.
# ─────────────────────────────────────────────────────────────────────────────
TRADINGAGENTS_STARTING_CASH=10000
TRADINGAGENTS_MAX_POSITIONS=10
TRADINGAGENTS_MAX_POSITION_SIZE=0.10
TRADINGAGENTS_MAX_SECTOR_EXPOSURE=0.30
TRADINGAGENTS_MAX_DAILY_LOSS=0.05
TRADINGAGENTS_MAX_MONTHLY_LOSS=0.15
TRADINGAGENTS_PAPER_TRADING_ENABLED=true
TRADINGAGENTS_FMP_ENABLED=false
TRADINGAGENTS_FMP_DAILY_LIMIT=250

# ─────────────────────────────────────────────────────────────────────────────
# LIVE TRADING (DISABLED BY DEFAULT — DO NOT ENABLE UNLESS READY)
# ─────────────────────────────────────────────────────────────────────────────

# Master live-trading toggle. Even with this on, LIVE_TRADING_HARD_BLOCKED
# in tradingagents/compliance.py must be set to False in source code.
LIVE_TRADING_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# FIDELITY BROKERAGE (required only for live trading)
# ─────────────────────────────────────────────────────────────────────────────
FIDELITY_USERNAME=
FIDELITY_PASSWORD=
FIDELITY_ACCOUNT_NUMBER=
FIDELITY_TOTP_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION (web dashboard login)
# ─────────────────────────────────────────────────────────────────────────────

# Secret for step-up 2FA on sensitive endpoints
STEP_UP_SECRET=change-me-to-a-random-secret

# Bootstrap admin email (gets admin access on first login)
CF_ACCESS_BOOTSTRAP_ADMIN=

# Cloudflare Access (optional — for remote access via cloudflared tunnel)
CF_ACCESS_REQUIRED=false
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_LOCAL_DEV=false
CF_ACCESS_LOCAL_DEV_EMAIL=

# WebAuthn (passkey auth)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8001

# ─────────────────────────────────────────────────────────────────────────────
# ALERTS (SMS / messaging)
# ─────────────────────────────────────────────────────────────────────────────

# Phone number to receive buy/sell SMS alerts
PAPER_SMS_NUMBER=
SMS_NUMBER=

# SMS provider: sendblue | textbelt | textnow
SMS_PROVIDER=

# SendBlue (recommended)
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_INBOUND_SECRET=

# TextBelt
TEXTBELT_KEY=
TEXTBELT_SENDER=

# TextNow
TEXTNOW_USERNAME=
TEXTNOW_SID=
TEXTNOW_PHONE=
TEXTNOW_ALERT_NUMBER=
TEXTNOW_CSRF_COOKIE=

# Telegram bot alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts
EMAIL_FROM=
EMAIL_REPLY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Gmail API (alternative to SMTP)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# AI / LLM (for optional signal analysis and thematic scanning)
# ─────────────────────────────────────────────────────────────────────────────

# LLM provider: openrouter | cloudflare
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_KEY=

# Cloudflare AI Gateway
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_DEFAULT_QUICK_MODEL=
CLOUDFLARE_DEFAULT_DEEP_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# MARKET DATA (optional premium sources)
# ─────────────────────────────────────────────────────────────────────────────

# Alpha Vantage (optional premium indicator data)
ALPHA_VANTAGE_API_KEY=

# MarketAux (optional news sentiment)
MARKETAUX_API_TOKEN=

# Brave Search (optional news search)
BRAVE_SEARCH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CLOUD STORAGE (optional — for syncing state across machines)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (user accounts + state sync)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cloudflare D1 / KV (alternative state sync)
CLOUDFLARE_D1_DATABASE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN / SECURITY
# ─────────────────────────────────────────────────────────────────────────────

MANAGER_API_KEY=change-me-to-a-random-key
BROKER_SESSION_KEY=
TRADINGAGENTS_BROKER_SESSION_KEY=

# Twitter/X (optional — for social sentiment features)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
