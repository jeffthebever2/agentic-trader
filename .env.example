# Agentic Trader — Environment Configuration
# Copy to .env and fill in your values.
# Lines starting with # are comments. All values are optional unless marked REQUIRED.

# ─────────────────────────────────────────────────────────────────────────────
# WEB SERVER
# ─────────────────────────────────────────────────────────────────────────────
WEB_PORT=8001
WEB_HOST=127.0.0.1

# Public URL (used in SMS/email alerts). Leave blank for local-only use.
PUBLIC_APP_URL=
PUBLIC_DASHBOARD_URL=

# Comma-separated origins allowed for CORS (add your frontend dev URL)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# PAPER TRADING
# ─────────────────────────────────────────────────────────────────────────────

# Directory where portfolio state files are written
# Default: tmp/paper_trading_today — portfolio comparison dashboard reads from here
PAPER_OUTPUT_DIR=tmp/paper_trading_today

# Auto-start paper trading on web server launch
# (set to true only if you want hands-off daily automation)
PAPER_AUTOSTART_IGNORE_WINDOW=false

# Thematic auto-scan (experimental sector momentum overlay)
THEMATIC_AUTO_SCAN=false

# ─────────────────────────────────────────────────────────────────────────────
# PORTFOLIO / RISK PARAMETERS
# These override the default CLI args for paper_trade_today.py.
# All are optional — unset = use the script's built-in defaults.
# ─────────────────────────────────────────────────────────────────────────────
TRADINGAGENTS_STARTING_CASH=10000
TRADINGAGENTS_MAX_POSITIONS=10
TRADINGAGENTS_MAX_POSITION_SIZE=0.10
TRADINGAGENTS_MAX_SECTOR_EXPOSURE=0.30
TRADINGAGENTS_MAX_DAILY_LOSS=0.05
TRADINGAGENTS_MAX_MONTHLY_LOSS=0.15
TRADINGAGENTS_PAPER_TRADING_ENABLED=true
TRADINGAGENTS_FMP_ENABLED=false
TRADINGAGENTS_FMP_DAILY_LIMIT=250

# Fidelity-based rule model from deep-research-report.md:
# Fidelity cash/Youth are settlement-based, not old PDT-count based.
PAPER_BROKER_RULE_PROFILE=fidelity_cash
PAPER_ENFORCE_LEGACY_PDT=false
FIDELITY_ACCOUNT_RULE_PROFILE=fidelity_cash

# ─────────────────────────────────────────────────────────────────────────────
# LIVE TRADING (DISABLED BY DEFAULT — DO NOT ENABLE UNLESS READY)
# ─────────────────────────────────────────────────────────────────────────────

# Master live-trading toggle. Even with this on, LIVE_TRADING_HARD_BLOCKED
# in tradingagents/compliance.py must be set to False in source code.
LIVE_TRADING_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# COPY TRADING — follow a paper competition portfolio into real Fidelity
# ─────────────────────────────────────────────────────────────────────────────
# Master switch for the background copy-trade reconcile loop (HIL + autonomous).
COPYTRADE_ENABLED=false
# Reconcile cadence in minutes (market hours only). Min 2.
COPYTRADE_INTERVAL_MIN=10
# Kill-switch for AUTONOMOUS mode. When false, portfolios set to "auto" still only
# queue HIL approvals — no order fires unattended. Set true ONLY to allow the
# follower to place real orders with no per-trade 2FA tap (compliance gates,
# LIVE_TRADING_HARD_BLOCKED, LIVE_TRADING_ENABLED and the trusted-quote gate all
# still apply — this replaces ONLY the interactive step-up prompt).
COPYTRADE_AUTONOMOUS=false

# ─────────────────────────────────────────────────────────────────────────────
# BROKER DATA vs EXECUTION (SnapTrade migration)
# ─────────────────────────────────────────────────────────────────────────────
# Execution stays LOCAL (Playwright). SnapTrade is DATA-ONLY for Fidelity
# (balances/holdings/transactions/order history) — it cannot place Fidelity trades.
#
# Kill switch for the local Fidelity order-placement path (default on = current
# behavior). Set false to disable order placement without touching read/data flows.
FIDELITY_LOCAL_EXECUTION_ENABLED=true
# SnapTrade data provider — OPTIONAL overlay. The app runs fully on local Fidelity
# data + execution without it; a missing/invalid key degrades cleanly (the app just
# uses local data). Turn on only when the keys below authenticate.
#
# Getting keys: sign up at snaptrade.com → clientId + consumerKey. Trial keys work
# for testing. PRODUCTION access (real, uncapped brokerage connections) requires
# submitting company info + a public-facing app page / privacy policy to SnapTrade
# for review — until then, leave SNAPTRADE_ENABLED=false and run on local Fidelity.
SNAPTRADE_ENABLED=false
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# SnapTrade LIVE order placement (Webull only — Fidelity is data-only). Real money,
# opt-in, OFF by default. Even on, orders still pass validate_live_order + step-up 2FA
# + the capability gate. Fidelity execution is unaffected (stays local Playwright).
SNAPTRADE_TRADING_ENABLED=false

# ─────────────────────────────────────────────────────────────────────────────
# FIDELITY BROKERAGE (required only for live trading)
# ─────────────────────────────────────────────────────────────────────────────
FIDELITY_USERNAME=
FIDELITY_PASSWORD=
FIDELITY_ACCOUNT_NUMBER=
FIDELITY_TOTP_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# AUTHENTICATION (web dashboard login)
# ─────────────────────────────────────────────────────────────────────────────

# Secret for step-up 2FA on sensitive endpoints
STEP_UP_SECRET=change-me-to-a-random-secret

# Bootstrap admin email (gets admin access on first login)
CF_ACCESS_BOOTSTRAP_ADMIN=

# Cloudflare Access (optional — for remote access via cloudflared tunnel)
CF_ACCESS_REQUIRED=false
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_LOCAL_DEV=false
CF_ACCESS_LOCAL_DEV_EMAIL=

# WebAuthn (passkey auth)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:8001

# ─────────────────────────────────────────────────────────────────────────────
# ALERTS (SMS / messaging)
# ─────────────────────────────────────────────────────────────────────────────

# Phone number to receive buy/sell SMS alerts
PAPER_SMS_NUMBER=
SMS_NUMBER=

# SMS provider: sendblue | textbelt | textnow
SMS_PROVIDER=

# SendBlue (recommended)
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
SENDBLUE_INBOUND_SECRET=

# TextBelt
TEXTBELT_KEY=
TEXTBELT_SENDER=

# TextNow
TEXTNOW_USERNAME=
TEXTNOW_SID=
TEXTNOW_PHONE=
TEXTNOW_ALERT_NUMBER=
TEXTNOW_CSRF_COOKIE=

# Telegram bot alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email alerts
EMAIL_FROM=
EMAIL_REPLY_TO=
# Transport: "resend" | "smtp" | blank (auto: use Resend if RESEND_API_KEY set).
EMAIL_PROVIDER=
# Resend (https://resend.com) — preferred transport when set.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# CLERK — optional STEP-UP 2FA (re-verify with Google before trading)
# ─────────────────────────────────────────────────────────────────────────────
# Primary login stays Cloudflare Access; Clerk is an ADDITIONAL step-up factor.
# Dormant until set. The step-up passes only if the Clerk (Google) email matches
# the signed-in user's email.
CLERK_SECRET_KEY=            # sk_...  (Clerk Backend API key; server-only)
CLERK_ISSUER=               # e.g. https://your-app.clerk.accounts.dev  (JWT iss)
CLERK_JWKS_URL=             # optional; defaults to ${CLERK_ISSUER}/.well-known/jwks.json
# Frontend (Vite) publishable key — enables the "Verify with Google" step-up button.
VITE_CLERK_PUBLISHABLE_KEY= # pk_...

# Gmail API (alternative to SMTP)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# AI / LLM (for optional signal analysis and thematic scanning)
# ─────────────────────────────────────────────────────────────────────────────

# LLM provider: openrouter | cloudflare
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
OPENROUTER_KEY=

# Cloudflare AI Gateway
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_URL=
CLOUDFLARE_DEFAULT_QUICK_MODEL=
CLOUDFLARE_DEFAULT_DEEP_MODEL=

# ─────────────────────────────────────────────────────────────────────────────
# MARKET DATA (optional premium sources)
# ─────────────────────────────────────────────────────────────────────────────

# Alpha Vantage (optional premium indicator data)
ALPHA_VANTAGE_API_KEY=

# MarketAux (optional news sentiment)
MARKETAUX_API_TOKEN=

# Brave Search (optional news search)
BRAVE_SEARCH_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# CLOUD STORAGE (optional — for syncing state across machines)
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (user accounts + state sync)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cloudflare D1 / KV (alternative state sync)
CLOUDFLARE_D1_DATABASE_ID=

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN / SECURITY
# ─────────────────────────────────────────────────────────────────────────────

MANAGER_API_KEY=change-me-to-a-random-key
BROKER_SESSION_KEY=
TRADINGAGENTS_BROKER_SESSION_KEY=

# Twitter/X (optional — for social sentiment features)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# X API pay-per-use guard for social sentiment.
# Posts: Read is billed per returned post; keep this aligned with X Developer Console.
X_MONTHLY_CREDIT_USD=25
X_POST_READ_COST_USD=0.005
X_INTENSITY=safe
X_PROFIT_REINVEST_PCT=5
X_MAX_SEARCHES_PER_SCAN=10
X_DEEP_DIVE_TOP_N=5

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING
# ─────────────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs

# ═════════════════════════════════════════════════════════════════════════════
# TRADING — arming, safety and the autonomous loops
#
# These were undocumented: 118 of the 210 variables the code reads had no entry
# here, including EVERY trading flag. That is how a box ends up with live
# trading armed and no stop watcher.
#
# Booleans accept 1/true/yes/on (case- and whitespace-insensitive). Anything
# else, including unset, is false.
#
# The startup preflight (tradingagents/preflight.py, GET /health/preflight)
# validates the COMBINATIONS below and latches live execution OFF on a CRITICAL
# finding. Read its output before trusting a new deployment.
# ═════════════════════════════════════════════════════════════════════════════

# ── Live-money master switches ───────────────────────────────────────────────
# Real orders require ALL of: LIVE_TRADING_HARD_BLOCKED=False (source constant
# in tradingagents/compliance.py, deliberately not env-settable),
# LIVE_TRADING_ENABLED=true, FIDELITY_LOCAL_EXECUTION_ENABLED=true,
# FIDELITY_BROWSER_DISABLED unset/false — plus per-trade step-up 2FA.
LIVE_TRADING_ENABLED=false
FIDELITY_LOCAL_EXECUTION_ENABLED=true
# Refuses to launch the Playwright browser at all. Fidelity blocks true headless,
# so any launch is a real (if off-screen) Chrome window.
FIDELITY_BROWSER_DISABLED=false
# false = on-screen browser for debugging login/scrape; default headed off-screen.
FIDELITY_HEADLESS=true

# ── Account protection (set these BEFORE arming live trading) ────────────────
# Comma-separated account numbers the system must never trade — Roth/retirement.
FIDELITY_PROTECTED_ACCOUNTS=
WEBULL_PROTECTED_ACCOUNTS=
# Refuse the broker's DEFAULT account, so an order can never silently land on
# whichever account Fidelity happens to have selected. Leave on.
FIDELITY_REQUIRE_EXPLICIT_ACCOUNT=true
FIDELITY_TRADE_ACCOUNT=
FIDELITY_ACCOUNT_RULE_PROFILE=fidelity_cash
# Allows MARKET sells (exits only — market buys are unconditionally prohibited).
# Guarantees a fill when getting out matters more than the price.
ALLOW_MARKET_SELL=false

# ── Autonomous loops ─────────────────────────────────────────────────────────
# Social-momentum scanner. Propose-only; places no orders by itself.
THEMATIC_AUTO_SCAN=false
THEMATIC_MIN_SCAN_INTERVAL_MIN=30
THEMATIC_SOURCE_TIMEOUT=25
THEMATIC_SOURCE_CONCURRENCY=16
# Mechanical exits on the thematic PAPER book.
THEMATIC_EXIT_LOOP=false
THEMATIC_EXIT_INTERVAL_MIN=15
# Holdings Brain + exit guard. Gates ALL THREE live-book stop watchers, so live
# trading without this means real positions get ZERO stop checks per day.
HOLDINGS_BRAIN_ENABLED=false
HOLDINGS_BRAIN_INTERVAL_MIN=240
EXIT_GUARD_INTERVAL_MIN=15
# Autonomous live SELL executor. Requires a step-up-armed record; the exit guard
# stays propose-only by design (see AUTO_LIVE_EXIT_FLAGS).
THEMATIC_LIVE_EXIT_AUTONOMOUS=false
THEMATIC_LIVE_EXIT_INTERVAL_MIN=5
THEMATIC_LIVE_EXIT_LIMIT_PCT=-2.0
THEMATIC_LIVE_EXIT_MAX_ORDERS=3
# Copy-trade: mirror a paper competition portfolio into real Fidelity. The ONLY
# route to a real order with no human in the loop — arm deliberately.
COPYTRADE_ENABLED=false
COPYTRADE_AUTONOMOUS=false
COPYTRADE_INTERVAL_MIN=10

# ── Signal scoring and admission ─────────────────────────────────────────────
THEMATIC_MIN_SIGNAL_SCORE=70
THEMATIC_MAX_POSITIONS=10
THEMATIC_HARD_MAX_POSITIONS=20
THEMATIC_TOP_N_ACTIONABLE=3
THEMATIC_SIGNAL_TTL_HOURS=24
ALERT_COOLDOWN_HOURS=12
ALERT_RESCORE_DELTA=8
# Optional signal sources (each costs latency; discovery/analyst need API keys).
THEMATIC_DISCOVERY=false
THEMATIC_DISCOVERY_MAX_UNIVERSE=350
THEMATIC_ANALYST=false
THEMATIC_GOOGLE_TRENDS=false
THEMATIC_OPTIONS_FLOW=false
THEMATIC_TRUE_SHORT_INTEREST=false
THEMATIC_REGIME_GATE=false
THEMATIC_BREAKOUT_CONFIRM=false

# ── Sizing and risk ──────────────────────────────────────────────────────────
SIZER_BASE_POSITION_PCT=4.0
SIZER_MAX_POSITION_PCT=10.0
SIZER_MAX_SECTOR_PCT=30.0
SIZER_MAX_HEAT_PCT=80.0
# Reference vol for inverse-vol sizing. Thematic small-caps run 60-120%, so the
# 40 default pins the factor at its floor for nearly every name; ~70 makes it
# actually discriminate between candidates.
SIZER_TARGET_VOL_PCT=40.0
SIZER_MIN_DOLLAR=25.0
SIZER_CLUSTER_LINK_THRESHOLD=0.65
# Cap (% of account) applied when average daily volume is UNKNOWN. 0 = off
# (missing ADV is neutral). ~5 throttles names whose liquidity we cannot measure
# without binding on routine 2-4% positions.
SIZER_UNKNOWN_ADV_CAP_PCT=0
# Volatility-aware stops and risk-based sizing on the thematic path.
THEMATIC_ATR_STOPS=false
THEMATIC_RISK_SIZING=false
THEMATIC_RISK_PCT_PER_TRADE=1
THEMATIC_CORRELATION_GUARD=false
THEMATIC_MAX_CORRELATION=0.85
DIVERSIFY_ENABLED=true
DIVERSIFY_ENFORCE_LIVE=true
# Holdings Brain guardrails.
HOLDINGS_BRAIN_MIN_STOP_PCT=8
HOLDINGS_BRAIN_CONC_MAX_PCT=25
HOLDINGS_BRAIN_MIN_HOLD_DAYS=5
HOLDINGS_BRAIN_MAX_TRADES_PER_CYCLE=2
HOLDINGS_BRAIN_KEEP_MIN_CONVICTION=5
# Max points of ACCOUNT a single ADD may put on (the per-approval rate limit).
HOLDINGS_BRAIN_ADD_MAX_STEP_PCT=3
HOLDINGS_BRAIN_TRAIL_ATR_MULT=
HOLDINGS_BRAIN_TAKEOVER=false
HOLDINGS_BRAIN_TAKEOVER_STRICT=false

# ── Execution quality ────────────────────────────────────────────────────────
# Trusted execution quote sources: finnhub, twelve_data, fmp. yfinance is NEVER
# trusted for execution. With none of these set, PreTradeGate rejects every
# entry AND every exit — positions cannot be closed. Set at least one.
# TWELVE_DATA_API_KEY additionally supplies bid/ask, which switches the
# reference price to a true mid and activates the 75bps spread gate.
BROKER_QUOTE_MAX_AGE_SECONDS=120
QUOTE_GATEWAY=on

# ── Paper competition realism ────────────────────────────────────────────────
# One-way friction in bps applied against the trade. 0 = off, which flatters
# every strategy; copy-trade mirrors the leaderboard winner into REAL money, so
# an unmodelled spread selects the strategy most sensitive to it. 10-25 is
# realistic for these small-caps. Commission stays 0 (Fidelity US equities).
PAPER_SLIPPAGE_BPS=0
# Hard ceiling per paper position (% of equity). Backstop against risk-parity
# sizing with a missing ATR, which otherwise produces ~48% of equity in one name.
PAPER_POSITION_CAP_PCT=25

# ── Process safety (do not relax) ────────────────────────────────────────────
# Order locks, the paper-state lock and alert cooldowns are ALL in-process.
# A second worker or replica produces DUPLICATE LIVE ORDERS. Run exactly one web
# process — no `--workers N`, no horizontal replicas.
WEB_SINGLE_INSTANCE_LOCK=true

# ── Trading: remaining knobs ─────────────────────────────────────────────────
# Thematic behaviour
THEMATIC_PAPER_START_CASH=100000
THEMATIC_PRIMARY_EMAIL=
THEMATIC_SCAN_STALE_SECONDS=300
THEMATIC_MAXHOLD_RUN_PCT=12
THEMATIC_BUZZ_EXIT_GREEN_PCT=3
THEMATIC_PRICE_CONFIRM=true
THEMATIC_CONVICTION_CLAMP=true
THEMATIC_ADAPTIVE_WEIGHTS=true
THEMATIC_SHORT_OVERLAY=false
THEMATIC_CLUSTER_MAP=
THEMATIC_TRENDS_TICKERS=
THEMATIC_DISCOVERY_UNIVERSE=
THEMATIC_DISCOVERY_UNIVERSE_FILE=
# AI-assisted stages (free-tier models; each degrades gracefully when unavailable)
THEMATIC_AI_INTENT=true
THEMATIC_AI_INTENT_THRESHOLD=0.85
THEMATIC_AI_EXIT_CHECK=true
HOLDINGS_BRAIN_LLM=true
# Notifications
THEMATIC_CHART_SMS=false
THEMATIC_CHART_UPLOAD=false
THEMATIC_CHART_UPLOAD_URL=https://catbox.moe/user/api.php
THEMATIC_SMS_QUIET_HOURS=22-8
HOLDINGS_BRAIN_SMS=true
# Holdings Brain scoping (comma-separated account numbers)
HOLDINGS_BRAIN_ALLOWED_ACCOUNTS=
HOLDINGS_BRAIN_PROTECTED_ACCOUNTS=
HOLDINGS_BRAIN_TAKEOVER_DROP_LOSS_PCT=-25
# Fidelity session
FIDELITY_CACHE_TTL_SECONDS=600
# Storing a recoverable password is opt-in; creds are Fernet-encrypted at rest.
FIDELITY_STORE_CREDENTIALS=false
# Paper "sit-out day" tuning (higher bar on statistically weak weekdays)
PAPER_SKIP_DAY_MIN_RR=2.0
PAPER_SKIP_DAY_SIZE_FACTOR=0.5
PAPER_SKIP_DAY_ML_BUMP=0.05
PAPER_SKIP_DAY_MAX_HOLD=5
TRADINGAGENTS_PAPER_DECISION_LOG_PATH=
