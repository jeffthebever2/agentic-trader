# AI Orchestrator Configuration — copy to .env

# Paths or bare command names (resolved on PATH) for each AI CLI.
CLAUDE_CLI_PATH=claude
CLAUDE_CODE_PATH=claude-code
# Claude Code model/plan + Codex model/effort set via `orchestrate config`
# (defaults: claude-code=sonnet+plan mode, codex=gpt-5.5 medium effort)
GEMINI_CLI_PATH=gemini
# Gemini model is set via `orchestrate config --gemini-model <name>`
# (default: gemini-3.1-flash-lite — fast & cheap; cheapest: gemini-2.5-flash-lite)
OPENCODE_CLI_PATH=opencode
CODEX_CLI_PATH=codex

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Persistent runtime config lives in ~/.config/ai-orchestrator/config.json
# (override dir with AI_ORCH_CONFIG_DIR). The git/parallel/timeout settings
# there are written by the `git`, `parallel`, and config commands.
